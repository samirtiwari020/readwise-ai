# ==========================================
# Agentic Book & Document Research Assistant
# ==========================================

# --- Application ---
APP_NAME="Readwise AI Research Assistant"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (SQLAlchemy Async) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5433/readwise_ai

# --- Storage & Vector Database ---
UPLOAD_DIR=../data/uploads
CHROMA_PERSIST_DIR=../data/chroma
CHROMA_COLLECTION_NAME=document_chunks

# --- HuggingFace Embeddings & Cross-Encoder Reranker ---
# Use "cuda" if NVIDIA GPU PyTorch is installed, otherwise "cpu"
EMBEDDING_DEVICE=cuda
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HF_RERANKER_MODEL=BAAI/bge-reranker-base

# --- LLM Provider (choose one: gemini | openai | groq | ollama) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
JUDGE_LLM_MODEL=gemini-2.5-pro

# API Keys (fill the provider you select)
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Adaptive Chunking & Retrieval Tuning ---
CHUNK_MIN_TOKENS=200
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6

